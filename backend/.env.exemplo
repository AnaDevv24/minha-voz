# Modelo do arquivo backend/.env (a senha do banco). O .env NUNCA vai para o Git; este modelo vai.
#
# Jeito fácil: dois cliques em INICIAR.bat. Na primeira vez ele cria o .env sozinho
#              (pede só a senha do root do MySQL).
# Jeito manual: copie este arquivo para "backend/.env" e troque só a linha MYSQL_SENHA
#              pela senha que você usou no CREATE USER do Workbench.

# --- MySQL (deixe MYSQL_BANCO vazio para usar o arquivo dados.json) ---
MYSQL_HOST=localhost
MYSQL_PORTA=3306
MYSQL_BANCO=minha_voz
MYSQL_USUARIO=minhavoz_app
MYSQL_SENHA=TroqueEstaSenha

# Dias até a sessão expirar e ser preciso entrar de novo
DIAS_SESSAO=30

# 1 só no seu computador, para ver erros detalhados. Nunca ligue em um servidor público.
FLASK_DEBUG=0
