{
  "name": "minha-voz-caa",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Minha Voz - CAA: prancha de Comunicação Aumentativa e Alternativa para crianças com dificuldade de fala (protótipo funcional do TCC).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:servidor": "tsc --noEmit && vite build --mode servidor",
    "build:pages": "tsc --noEmit && vite build --mode previa",
    "build:previa": "tsc --noEmit && vite build --mode previa && node scripts/arquivo-unico.mjs",
    "api": "python backend/app.py"
  },
  "dependencies": {
    "lucide-react": "^1.50.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "tailwindcss": "^4.3.0",
    "typescript": "~5.9.0",
    "vite": "^8.3.0"
  }
}
